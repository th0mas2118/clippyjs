{
  "name": "@clippyjs/modern",
  "version": "1.0.0",
  "description": "Modern TypeScript implementation of ClippyJS - Add Clippy or his friends to any website",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "bun": "./src/index.ts"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs",
      "bun": "./src/plugin/index.ts"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs",
      "bun": "./src/vue/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "TYPESCRIPT_README.md"
  ],
  "scripts": {
    "dev": "bun run server.ts",
    "build": "bun run build.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "clippy",
    "microsoft",
    "office-assistant",
    "nostalgia",
    "animation",
    "typescript",
    "vue",
    "agent",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th0mas2118/clippyjs.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "trustedDependencies": [
    "bun"
  ]
}

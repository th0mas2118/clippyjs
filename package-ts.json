{
  "name": "@clippyjs/modern",
  "version": "1.0.0",
  "description": "Modern TypeScript implementation of ClippyJS - Add Clippy or his friends to any website",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "require": "./dist/plugin/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "assets",
    "TYPESCRIPT_README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ts": "tsc",
    "build:vite": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "clippy",
    "microsoft",
    "office-assistant",
    "nostalgia",
    "animation",
    "typescript",
    "vue",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th0mas2118/clippyjs.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
